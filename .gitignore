# OS/editor noise
.DS_Store
Thumbs.db
.vscode
node_modules/
.eslintcache

# Local temp/debug artifacts
.tmp_*
scripts/tmp_*.ps1
*.log

# Local backup/restore scratch folders (if created inside repo)
_restore_*/
backup_*/
scripts/qollock_pipeline.ps1
memory
plans
.claude/
.fallow/
mostrecentlogs.txt
tools/local_chat_translation/.venv/
tools/local_chat_translation/__pycache__/

# Self-build tool runtime artifacts (build_mod/build_mod.ps1 stays tracked)
build_mod/data/
build_mod/builds/
build_mod/*.vpk

# Profiler runs are local measurements, not shared state. A committed baseline
# goes stale the moment anyone edits the mod or the tree fixture, and then every
# --compare silently reports the wrong delta. Generate your own before/after pair:
#   node scripts/profile_hud.js --seconds 20 --save before
# See docs/PROFILING.md.
scripts/simulator/perf/runs/

# Local pre-update source snapshots. Keep these across game updates.
scripts/game_update_runs/

# Additional native snapshots and generated audits stay local. The historical
# tracked fixture remains available; portable tests do not depend on it.
captures/*.json
