#!/usr/bin/env bash
# Optional local hook template; shares the complete canonical offline gate.
set -euo pipefail

if [ "${QOLLOCK_SKIP_HOOKS:-}" = "true" ]; then
    echo "[QOLLOCK] Skipping pre-commit hooks (QOLLOCK_SKIP_HOOKS=true)"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
echo "[QOLLOCK] Running npm test (complete offline gate)..."
npm test
echo "[QOLLOCK] All pre-commit checks passed!"
