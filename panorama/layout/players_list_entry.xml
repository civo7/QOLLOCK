<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/players_list_entry.vcss_c" />
		<include src="s2r://panorama/styles/showrank_player_list.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/showrank_web_media_bridge.vjs_c" />
	</scripts>
	<CitadelPlayersListEntry class="ShowRankCleanPlayersListEntry" onload="if ($.ShowRankRegisterPlayerListRowReady) $.ShowRankRegisterPlayerListRowReady('escape_menu_players_list_row_ready');" onmouseover="if ($.ShowRankMarkPlayerListHover) $.ShowRankMarkPlayerListHover('players_list_hover');" onmouseout="if ($.ShowRankClearPlayerListHover) $.ShowRankClearPlayerListHover('players_list_out');">
		<Panel class="Controls">
			<Button class="MuteButton ToggleMuteButton" onmouseover="UIShowTextTooltip( #citadel_mute_player )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPlayerListEntrySetMuted( true )" />
			<Button class="UnmuteButton ToggleMuteButton" onmouseover="UIShowTextTooltip( #citadel_unmute_player )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPlayerListEntrySetMuted( false )" />
		</Panel>
		<Panel id="MainContents" hittestchildren="false" onmouseover="if ($.ShowRankMarkPlayerListHover) $.ShowRankMarkPlayerListHover('players_list_hover');" onmouseout="if ($.ShowRankClearPlayerListHover) $.ShowRankClearPlayerListHover('players_list_out');" onactivate="if ($.ShowRankMarkPlayerListHover) $.ShowRankMarkPlayerListHover('players_list_activate'); if ($.ShowRankRegisterPlayerListRowReady) $.ShowRankRegisterPlayerListRowReady('players_list_manual_activate');">
			<CitadelHeroBadge id="HeroBadge" />
			<Panel class="Details">
				<Panel class="ShowRankPlayerNameRow" hittest="false">
					<Label id="PlayerName" class="PlayerName" text="{s:player_name}" />
				</Panel>
				<Label class="PlayerHero" text="#Citadel_Player_Level_HeroLevel" />
			</Panel>
			<Image id="ShowRankPlayerListRankImage" class="ShowRankPlayerListRankImage" scaling="stretch-to-fit-preserve-aspect" hittest="false" />
		</Panel>
	</CitadelPlayersListEntry>
</root>
