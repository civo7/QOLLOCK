<root>
	<scripts>

	</scripts>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/hud_ability_modifier_shared.vcss_c" />
		<include src="s2r://panorama/styles/ability_hud_elements/element_common.vcss_c" />
		<include src="s2r://panorama/styles/ability_hud_elements/element_progress_bar.vcss_c" />
		<include src="s2r://panorama/styles/ability_hud_elements/element_progress_bar_text.vcss_c" />
	</styles>
	<Citadel_AbilityHUDElement_Progress class="ability_element_progress">
		<Panel id="channel_and_name">
			<Panel id="text_container" class="SplitLabelProgressBar">
				<SplitLabel id="ability_name" text="{s:ability_name}" class="SplitLabelName" />
				<Image id="ability_name_clipped" class="SplitLabelProgress" src="panel://ability_name" context="progress" progress="clip_right" />
			</Panel>
			<Panel id="legacy_progress_container">
				<Label class="legacy_castbar_name" text="{s:ability_name}" />
				<Panel id="legacy_bar_container">
					<Panel id="legacy_bar_bg" />
					<Panel id="legacy_bar_fg_container">
						<Panel id="legacy_bar_fg" context="progress" progress="fill_right" start_value="0" end_value="1" />
					</Panel>
				</Panel>
			</Panel>
			<Panel id="hint_container">
				<CitadelBinding id="CancelKeyBinding" />
				<Label class="action slash" text="/" />
				<CitadelBinding id="AbilityKeyBinding" />
				<Label class="action" html="true" text="#Cancel" />
			</Panel>
		</Panel>
	</Citadel_AbilityHUDElement_Progress>
</root>
